<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Authors>Robert Anstett</Authors>
    <Company>Southport Solutions, LLC</Company>
    <Copyright>© Southport Solutions, LLC. All rights reserved.</Copyright>
    <Description>MailGun Implementation of the Southport.Messaging.Email.Core</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/southportsolutions/Southport.Messaging.Email.MailGun</PackageProjectUrl>
    <RepositoryUrl>https://github.com/southportsolutions/Southport.Messaging.Email.MailGun</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mailgun;email;southport</PackageTags>
    <PackageReleaseNotes>Core library update.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
      <PackageReference Include="Handlebars.Net" Version="2.4.3" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'"/>
      <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.21" Condition="'$(TargetFramework)' == 'net9.0'"/>
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'"/>
      <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.21" Condition="'$(TargetFramework)' == 'net9.0'"/>
      <PackageReference Include="Southport.Messaging.Email.Core" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>


</Project>
